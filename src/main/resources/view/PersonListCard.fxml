<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<!-- The GridPane is the root, as an HBox around it gets a wrapping card's height wrong on JavaFX 25 -->
<GridPane id="cardPane" fx:id="cardPane" hgap="12" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <columnConstraints>
    <ColumnConstraints minWidth="28" />
    <ColumnConstraints hgrow="ALWAYS" minWidth="10" prefWidth="150" />
  </columnConstraints>
  <padding>
    <Insets top="14" right="18" bottom="16" left="12" />
  </padding>
  <Label fx:id="id" styleClass="card-index" maxWidth="Infinity" alignment="TOP_RIGHT" GridPane.valignment="TOP">
    <minWidth>
      <!-- Ensures that the label text is never truncated -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
  <VBox spacing="3" GridPane.columnIndex="1">
    <!-- TextFlows wrap long names, emails and addresses, and work out their height for the card's width -->
    <TextFlow fx:id="nameAndTags" lineSpacing="4">
      <Text fx:id="name" styleClass="card-name" />
    </TextFlow>
    <TextFlow>
      <Text fx:id="phone" styleClass="card-text" />
      <Text styleClass="card-muted" text="  ·  " />
      <Text fx:id="email" styleClass="card-text" />
    </TextFlow>
    <TextFlow fx:id="addressLine">
      <Text fx:id="address" styleClass="card-text" />
      <Text styleClass="card-text" text="   " />
      <Label fx:id="postalCode" styleClass="card-postal-code" />
    </TextFlow>
    <Label fx:id="noPreorder" styleClass="card-no-preorder" text="No preorder">
      <VBox.margin>
        <Insets top="3" />
      </VBox.margin>
    </Label>
    <!-- The preorder panel: how it will be handed over, then one row per item, added by PersonCard -->
    <VBox fx:id="preorder" spacing="5">
      <VBox.margin>
        <Insets top="5" />
      </VBox.margin>
      <padding>
        <Insets top="9" right="6" bottom="10" left="6" />
      </padding>
      <HBox spacing="7" alignment="CENTER_LEFT">
        <padding>
          <Insets left="6" right="6" />
        </padding>
        <SVGPath fx:id="preorderIcon" styleClass="preorder-icon" />
        <Label fx:id="preorderHeader" styleClass="preorder-header" wrapText="true" />
      </HBox>
      <Label fx:id="handoverNotes" styleClass="preorder-handover-notes" wrapText="true">
        <padding>
          <Insets left="6" right="6" />
        </padding>
      </Label>
      <Region styleClass="preorder-divider" minHeight="1" prefHeight="1" maxHeight="1">
        <VBox.margin>
          <Insets top="3" right="6" bottom="1" left="6" />
        </VBox.margin>
      </Region>
      <VBox fx:id="preorderItems" spacing="5" />
    </VBox>
  </VBox>
</GridPane>
