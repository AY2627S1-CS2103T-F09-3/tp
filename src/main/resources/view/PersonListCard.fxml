<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- The GridPane is the root, as an HBox around it gets a wrapping card's height wrong on JavaFX 25 -->
<GridPane id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <columnConstraints>
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
  </columnConstraints>
  <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
    <padding>
      <Insets top="5" right="5" bottom="5" left="15" />
    </padding>
    <HBox spacing="0.5" alignment="CENTER_LEFT">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the label text is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
    </HBox>
    <FlowPane fx:id="tags" />
    <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" />
    <Label fx:id="address" styleClass="cell_small_label" text="\$address" />
    <Label fx:id="postalCode" styleClass="cell_small_label" text="\$postalCode" />
    <Label fx:id="email" styleClass="cell_small_label" text="\$email" />
    <!-- The preorder panel: how it will be handed over, then one row per item, added by PersonCard -->
    <VBox fx:id="preorder" spacing="4">
      <VBox.margin>
        <Insets top="6" right="10" bottom="3" />
      </VBox.margin>
      <padding>
        <Insets top="8" right="10" bottom="9" left="10" />
      </padding>
      <HBox spacing="7" alignment="CENTER_LEFT">
        <SVGPath fx:id="preorderIcon" styleClass="preorder-icon" />
        <Label fx:id="preorderHeader" styleClass="preorder-header" wrapText="true" />
      </HBox>
      <Label fx:id="handoverNotes" styleClass="preorder-handover-notes" wrapText="true" />
      <Region styleClass="preorder-divider" minHeight="1" prefHeight="1" maxHeight="1" />
      <VBox fx:id="preorderItems" spacing="2" />
    </VBox>
  </VBox>
</GridPane>
