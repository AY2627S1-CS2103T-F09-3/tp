<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>

<!-- One view is shown at a time; SidePanel decides which -->
<StackPane styleClass="side-panel" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <StackPane fx:id="helpView" />
  <StackPane fx:id="productView" />
  <StackPane fx:id="deliveryView" />
</StackPane>
