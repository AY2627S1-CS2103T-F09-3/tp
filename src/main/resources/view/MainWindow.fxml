<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The minimum width fits both columns at their minimum widths, with the gaps and window border. The minimum
     height fits a 1280x720 screen at 150%, which is 480 px tall, less the taskbar. -->
<fx:root type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         title="LeBake" minWidth="800" minHeight="420" onCloseRequest="#handleExit">
  <icons>
    <Image url="@/images/address_book_32.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@DarkTheme.css" />
        <URL value="@Extensions.css" />
      </stylesheets>

      <!-- Gets the :compact pseudo-class in a narrow window, which makes the gaps around the customer list smaller -->
      <VBox fx:id="windowContent" styleClass="window-content">
        <MenuBar fx:id="menuBar" VBox.vgrow="NEVER">
          <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <MenuItem fx:id="helpMenuItem" mnemonicParsing="false" onAction="#handleHelp" text="Help" />
          </Menu>
        </MenuBar>

        <!-- The paddings and gaps of both columns are in DarkTheme.css -->
        <HBox fx:id="columns" styleClass="window-columns" VBox.vgrow="ALWAYS">
          <!-- Wide enough that cards keep whole words on a line; the column takes any extra width -->
          <VBox fx:id="mainColumn" styleClass="window-column" spacing="8" minWidth="450" HBox.hgrow="ALWAYS">
            <StackPane fx:id="commandBoxPlaceholder" VBox.vgrow="NEVER" />
            <!-- Takes the height of the whole message, unless the window is too short for both the message and
                 the customer list's minimum height; then the message scrolls -->
            <StackPane fx:id="resultDisplayPlaceholder" VBox.vgrow="NEVER" />
            <StackPane fx:id="searchCriteriaDisplayPlaceholder" VBox.vgrow="NEVER" />
            <!-- Takes the rest of the height, but always keeps enough for the top of a customer card -->
            <StackPane fx:id="personListPanelPlaceholder" minHeight="80" prefHeight="80" VBox.vgrow="ALWAYS" />
          </VBox>

          <!-- Help and the preparation summaries, one at a time -->
          <StackPane fx:id="sidePanelPlaceholder" minWidth="300" prefWidth="360" maxWidth="460" />
        </HBox>

        <StackPane fx:id="statusbarPlaceholder" VBox.vgrow="NEVER" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
