<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="productSummary" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER" focusTraversable="true"
            minHeight="100" prefHeight="180" maxHeight="180" styleClass="product-summary"
            accessibleText="Product preparation summary. Use arrow keys or Page Up and Page Down to scroll.">
  <content>
    <VBox spacing="6" fillWidth="true">
      <padding>
        <Insets top="10" right="12" bottom="10" left="12" />
      </padding>
      <Label fx:id="productHeading" wrapText="true" maxWidth="Infinity" styleClass="product-summary-heading" />
      <Label fx:id="counts" wrapText="true" maxWidth="Infinity" />
      <Label fx:id="quantity" wrapText="true" maxWidth="Infinity" />
      <Label fx:id="remarks" wrapText="true" maxWidth="Infinity" />
    </VBox>
  </content>
</ScrollPane>
