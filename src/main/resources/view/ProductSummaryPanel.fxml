<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="productSummary" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER" focusTraversable="true"
            styleClass="product-summary, side-panel-content"
            accessibleText="Product preparation summary. Use arrow keys or Page Up and Page Down to scroll.">
  <content>
    <VBox spacing="8" fillWidth="true">
      <padding>
        <Insets top="12" right="14" bottom="14" left="14" />
      </padding>
      <Label fx:id="productHeading" wrapText="true" maxWidth="Infinity" styleClass="side-panel-title" />
      <Label fx:id="counts" wrapText="true" maxWidth="Infinity" />
      <Label fx:id="quantity" wrapText="true" maxWidth="Infinity" />
      <Label fx:id="remarks" wrapText="true" maxWidth="Infinity" />
    </VBox>
  </content>
</ScrollPane>
